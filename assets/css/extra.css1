/*
 * Site-specific overrides.
 *
 * This file is enqueued after the main theme CSS so you can adjust spacing,
 * colors, or small presentation details without editing generated/build files.
 */

.healen-react-body,
.healen-react-body #root {
  font-family: "Inter", sans-serif;
}

.healen-gform {
  color: #1d3a5f;
}

.healen-gform .gform_wrapper,
.healen-gform .gform-theme,
.healen-gform .gform-theme--foundation,
.healen-gform .gform-theme--framework {
  font-family: "Inter", sans-serif;
}

.healen-gform .gform_wrapper.gravity-theme .gform_fields,
.healen-gform .gform-theme--foundation .gform_fields {
  row-gap: 16px;
}

.healen-gform .gform_wrapper.gravity-theme .gfield_label,
.healen-gform .gform-theme--foundation .gfield_label,
.healen-gform .gfield_label {
  color: rgba(29, 58, 95, 0.5);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.3;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.healen-gform .gfield_required,
.healen-gform .gfield_required_text {
  color: #809eb1;
  font-size: 11px;
}

.healen-gform input[type="text"],
.healen-gform input[type="email"],
.healen-gform input[type="tel"],
.healen-gform input[type="url"],
.healen-gform input[type="number"],
.healen-gform select,
.healen-gform textarea {
  background: #fff;
  border: 1.5px solid rgba(29, 58, 95, 0.15);
  border-radius: 12px;
  box-shadow: 0 1px 4px rgba(29, 58, 95, 0.05);
  color: #1d3a5f;
  font-family: "Inter", sans-serif;
  font-size: 14px;
  line-height: 1.4;
  min-height: 50px;
  outline: none;
  padding: 12px 16px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  width: 100%;
}

.healen-gform textarea {
  min-height: 138px;
  resize: vertical;
}

.healen-gform select {
  appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, #809eb1 50%),
    linear-gradient(135deg, #809eb1 50%, transparent 50%);
  background-position:
    calc(100% - 20px) 22px,
    calc(100% - 14px) 22px;
  background-repeat: no-repeat;
  background-size: 6px 6px, 6px 6px;
  padding-right: 42px;
}

.healen-gform input:focus,
.healen-gform select:focus,
.healen-gform textarea:focus {
  border-color: rgba(29, 58, 95, 0.45);
  box-shadow: 0 0 0 4px rgba(187, 219, 237, 0.38);
}

.healen-gform .gform_footer,
.healen-gform .gform_page_footer {
  margin-top: 18px;
  padding: 0;
}

.healen-gform .gform_button,
.healen-gform input[type="submit"],
.healen-gform button[type="submit"] {
  align-items: center;
  background: #1d3a5f;
  border: 0;
  border-radius: 999px;
  box-shadow: none;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 700;
  justify-content: center;
  line-height: 1;
  min-height: 52px;
  padding: 16px 32px;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.healen-gform .gform_button:hover,
.healen-gform input[type="submit"]:hover,
.healen-gform button[type="submit"]:hover {
  background: #0f2840;
  transform: translateY(-1px);
}

.healen-gform .gform_validation_errors,
.healen-gform .validation_error {
  background: #fff5f5;
  border: 1px solid rgba(229, 62, 62, 0.3);
  border-radius: 14px;
  box-shadow: none;
  color: #9b2c2c;
  font-size: 14px;
  margin-bottom: 18px;
  padding: 14px 16px;
}

.healen-gform .gfield_error input,
.healen-gform .gfield_error select,
.healen-gform .gfield_error textarea {
  border-color: #e53e3e;
}

.healen-gform .gfield_validation_message,
.healen-gform .validation_message {
  background: transparent;
  border: 0;
  color: #e53e3e;
  font-size: 12px;
  margin-top: 6px;
  padding: 0;
}

.healen-gform .gform_confirmation_message {
  background: #f0faf5;
  border: 1.5px solid rgba(29, 58, 95, 0.1);
  border-radius: 20px;
  color: rgba(29, 58, 95, 0.68);
  font-size: 16px;
  line-height: 1.7;
  padding: 34px;
  text-align: center;
}

@media (max-width: 640px) {
  .healen-gform .gform_button,
  .healen-gform input[type="submit"],
  .healen-gform button[type="submit"] {
    width: 100%;
  }
}

#services.py-24.md\:py-32.px-6.md\:px-12 {
  display: none;
}

.page-template-page-contact .gform-body.gform_body input[type="text"],
.page-template-page-contact .gform-body.gform_body input[type="email"],
.page-template-page-contact .gform-body.gform_body input[type="tel"],
.page-template-page-contact .gform-body.gform_body textarea {
  background: #fff;
  border: 1.5px solid rgba(29, 58, 95, 0.15);
  border-radius: 12px;
  box-shadow: rgba(29, 58, 95, 0.05) 0 1px 4px;
  font-size: 0.875rem;
  height: 47px;
  padding: 12px 16px;
}

.page-template-page-contact .gform-body.gform_body select {
  border: 1.5px solid rgba(29, 58, 95, 0.15);
  border-radius: 12px;
  box-shadow: rgba(29, 58, 95, 0.05) 0 1px 4px;
  color: #1d3a5f !important;
  font-size: 0.875rem;
  height: 47px;
  opacity: 0.6;
  padding: 3px 0 3px 16px;
}

.page-template-page-contact ::-webkit-input-placeholder {
  color: #1d3a5f !important;
  opacity: 0.4;
}

.page-template-page-contact ::-moz-placeholder {
  color: #1d3a5f !important;
  opacity: 0.4;
}

.page-template-page-contact :-ms-input-placeholder {
  color: #1d3a5f !important;
  opacity: 0.4;
}

.page-template-page-contact ::placeholder {
  color: #1d3a5f !important;
  opacity: 0.4;
}

.page-template-page-contact .gform-body.gform_body textarea {
  min-height: 127px;
}

.page-template-page-contact .gform_heading {
  display: none;
}

.page-template-page-contact input[type="submit"] {
  background-color: #1d3a5f !important;
  border-radius: 30px !important;
  font-size: 17px !important;
  font-weight: 600 !important;
  padding: 18px !important;
  width: 210px !important;
}
